# GitHub Personal Access Token
# Get one at: https://github.com/settings/tokens
# Permissions needed: public_repo (read-only is fine)
# Without this: 60 API requests/hour (enough for tree fetch, file content uses raw URLs)
# With this: 5000 API requests/hour
GITHUB_TOKEN=your_github_pat_here

# Groq API Key (needed from Phase 6 onward)
# Get one at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here