# Project Gnosis — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------------
# LLM Inference — NVIDIA NIM Serverless
# -----------------------------------------------------------------------
# Get a free API key at https://build.nvidia.com
# Click "Get API Key" on any model page (e.g. poolside/laguna-xs-2.1)
NVIDIA_API_KEY=nvapi-...

# Optional: override the default NVIDIA NIM endpoint
# Default: https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: override the default model.
# Default: poolside/laguna-xs-2.1 (code-specialised, ~2-4s per explanation)
# NVIDIA retires NIM models regularly — a retired model returns 404/410 and
# produces no explanations, so change this only to a model you have verified
# against the live catalogue.
# NVIDIA_MODEL=poolside/laguna-xs-2.1

# Optional: comma-separated models tried, in order, when the primary fails.
# Default: meta/llama-3.2-90b-vision-instruct
# NVIDIA_MODEL_FALLBACKS=meta/llama-3.2-90b-vision-instruct

# Optional: cap concurrent explanation requests (default 2).
# NVIDIA_LLM_MAX_CONCURRENCY=2

# -----------------------------------------------------------------------
# GitHub API — optional but recommended
# -----------------------------------------------------------------------
# Without a token: 60 unauthenticated requests/hour
# With a token:    5,000 requests/hour
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=ghp_...

# Per-request GitHub PAT encryption (required when a request includes
# github_token). Generate once and share the same value with API and RQ worker
# processes; keep it in a secret store, never in frontend configuration.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GNOSIS_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------
# ChromaDB — optional
# -----------------------------------------------------------------------
# Override the default ChromaDB persistence directory
# Default: ./chroma_db
# CHROMA_DB_PATH=./chroma_db

# -----------------------------------------------------------------------
# Redis & Task Queue (Production / Distributed Workers) — optional
# -----------------------------------------------------------------------
# If unset, JobStore and the queue run entirely in-process (local thread pool).
# If set but unreachable, the API starts in DEGRADED mode: jobs live in memory,
# /health returns status="degraded", and dispatch stays in-process. Writes are
# never silently split between Redis and memory.
# REDIS_URL=redis://localhost:6379/0
# RQ_QUEUE_NAME=gnosis_jobs
# JOB_TIMEOUT_SECONDS=1800
# TTL applied to completed/failed job records (seconds). Default 86400 (24h).
# Set 0 to keep records forever (not recommended for Redis backends).
# JOB_TTL_SECONDS=86400

# API protection and Chroma collection retention
# Comma-separated browser origins. Set deployed frontend origins in production.
# Default: local Vite origins.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example
# Repository submissions allowed per client IP and fixed window.
# ANALYZE_RATE_LIMIT=30
# ANALYZE_RATE_WINDOW_SECONDS=60
# Gnosis-managed Chroma collections expire after 7 days; 0 disables cleanup.
# CHROMA_COLLECTION_TTL_SECONDS=604800
