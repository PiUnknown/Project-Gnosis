# Project Gnosis — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------------
# LLM Inference — NVIDIA NIM Serverless
# -----------------------------------------------------------------------
# Get a free API key at https://build.nvidia.com
# Click "Get API Key" on any model page (e.g. meta/llama-3.3-70b-instruct)
NVIDIA_API_KEY=nvapi-...

# Optional: override the default NVIDIA NIM endpoint
# Default: https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: override the default model
# Default: meta/llama-3.3-70b-instruct
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# -----------------------------------------------------------------------
# GitHub API — optional but recommended
# -----------------------------------------------------------------------
# Without a token: 60 unauthenticated requests/hour
# With a token:    5,000 requests/hour
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=ghp_...

# -----------------------------------------------------------------------
# ChromaDB — optional
# -----------------------------------------------------------------------
# Override the default ChromaDB persistence directory
# Default: ./chroma_db
# CHROMA_DB_PATH=./chroma_db

# -----------------------------------------------------------------------
# Redis & Task Queue (Production / Distributed Workers) — optional
# -----------------------------------------------------------------------
# If unset, JobStore operates in local in-memory fallback mode.
# Set for production, Docker Compose, or multi-user cloud deployments.
# REDIS_URL=redis://localhost:6379/0
# RQ_QUEUE_NAME=gnosis_jobs
# JOB_TIMEOUT_SECONDS=1800
# JOB_TTL_SECONDS=86400